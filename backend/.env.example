# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your key never leaves your machine.

# Any OpenAI-compatible API works. Free options:
#   Google Gemini (default)  https://generativelanguage.googleapis.com/v1beta/openai/
#                            free key: https://aistudio.google.com/app/apikey
#                            model: gemini-flash-latest (or gemini-2.5-flash)
#   Groq                     https://api.groq.com/openai/v1
#                            free key: https://console.groq.com/keys
#                            model: llama-3.3-70b-versatile
#   Ollama (runs locally)    http://localhost:11434/v1   model: llama3.2, no key needed
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.7

# The name your study buddy introduces itself with.
ASSISTANT_NAME=Nova

# SQLite by default. For Postgres: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./chat.db

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Messages a single client can send per minute.
RATE_LIMIT_PER_MINUTE=20

# How many earlier messages are sent to the model as context.
MAX_HISTORY_MESSAGES=20
