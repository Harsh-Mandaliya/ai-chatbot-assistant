# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your key never leaves your machine.

# ---------------------------------------------------------------------------
# ONLINE mode: a free cloud model. Needs internet and a free key. Has limits.
# ---------------------------------------------------------------------------
# Any OpenAI-compatible API works. Free options:
#   Google Gemini (default)  https://generativelanguage.googleapis.com/v1beta/openai/
#                            free key: https://aistudio.google.com/app/apikey
#                            model: gemini-flash-latest (or gemini-2.5-flash)
#   Groq                     https://api.groq.com/openai/v1
#                            free key: https://console.groq.com/keys
#                            model: llama-3.3-70b-versatile (text only, no images)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.7

# Online limits, to stay inside the free quota.
RATE_LIMIT_PER_MINUTE=20
ONLINE_IMAGES_PER_DAY=10
MAX_HISTORY_MESSAGES=20

# ---------------------------------------------------------------------------
# OFFLINE mode: a model running on your own computer with Ollama.
# No internet, no key, no limits. Install Ollama from https://ollama.com, then:
#   ollama pull gemma3:4b
# gemma3:4b understands text and images and runs on 8 GB of RAM.
# Bigger PCs can try gemma3:12b or qwen2.5-coder:7b (text only).
# ---------------------------------------------------------------------------
OFFLINE_BASE_URL=http://localhost:11434/v1
OFFLINE_MODEL=gemma3:4b
OFFLINE_MAX_HISTORY_MESSAGES=60

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# The name your study buddy introduces itself with.
ASSISTANT_NAME=Nova

# SQLite by default. For Postgres: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./chat.db

# Where uploaded screenshots and photos are stored, and how big each may be.
UPLOAD_DIR=uploads
MAX_IMAGE_MB=8

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
