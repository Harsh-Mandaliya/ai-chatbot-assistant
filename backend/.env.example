# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored, so your key never leaves your machine.

# Any OpenAI-compatible API works. A few that have a free tier or run locally:
#   Groq        https://api.groq.com/openai/v1      (free key at console.groq.com)
#   OpenRouter  https://openrouter.ai/api/v1        (has free models)
#   Ollama      http://localhost:11434/v1           (local, any key works)
#   OpenAI      https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.8

# The name your assistant introduces itself with.
ASSISTANT_NAME=Nova

# SQLite by default. For Postgres: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./chat.db

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Messages a single client can send per minute.
RATE_LIMIT_PER_MINUTE=20

# How many earlier messages are sent to the model as context.
MAX_HISTORY_MESSAGES=20
